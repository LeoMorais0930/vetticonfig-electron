{
  "name": "vetticonfig",
  "version": "4.0.0",
  "description": "Sistema de monitoramento de alarmes - VettiConfig",
  "main": "src/main/main.js",
  "author": "Vetti",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/rename-electron-dev.js"
  },
  "build": {
    "appId": "com.vetti.vetticonfig",
    "productName": "VettiConfig",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "bootstrap": "^5.3.3",
    "local-devices": "^3.0.0",
    "netmask": "^2.0.2"
  }
}
